[manager]
prepend_keymap = [
  { on = [ "l" ], run = "plugin smart-enter", desc = "Enter the child directory, or open the file" },
  { on = [ "P" ], run = "plugin max-preview", desc = "Maximize preview pane" },
  { on = [ "T" ], run = "plugin hide-preview", desc = "Hide preview pane" },
]

[input]
prepend_keymap = [
  { on = [ "<Esc>" ], run = "close", desc = "Cancel input" },
]
